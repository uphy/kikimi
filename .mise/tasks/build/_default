#!/usr/bin/env bash
#MISE description="Release ビルド (.app バンドル生成)"
#MISE depends=["build:swift"]
set -euo pipefail

version="${APP_VERSION:-0.0.0-dev}"

# Distribution build (`.github/workflows/release.yml`) vs. local build. The two differ in
# exactly one respect — where SwiftPM resource bundles go and whether the .app is signed —
# and only because those two requirements are mutually exclusive. See "Resource bundles"
# and "Code signing" below.
release_build="${KIKIMI_RELEASE_BUILD:-0}"

# Must match project.yml `PRODUCT_BUNDLE_IDENTIFIER` and the os_log subsystem.
bundle_id="io.github.uphy.Kikimi"
# Matches project.yml `MACOSX_DEPLOYMENT_TARGET`. Kept in sync manually because the SPM
# build (Package.swift `platforms: [.macOS(.v14)]`) has no notion of the .2 minor bump.
deployment_target="14.2"

app_root="build/Kikimi.app"
app_dir="$app_root/Contents"

menu_icon_src="Kikimi/Resources/Assets.xcassets/MenuBarIcon.imageset"
app_icon_src="Kikimi/Resources/Assets.xcassets/AppIcon.appiconset/AppIcon-1024.png"

fail() {
  echo "error: $*" >&2
  exit 1
}

# Anything the app cannot run without is asserted rather than silently skipped: a bundle
# that launches but is missing a resource only shows up after a release is published.
require_file() {
  [ -f "$1" ] || fail "missing required file: $1${2:+ — $2}"
}

require_file ".build/release/Kikimi" "run: mise run build:swift"
require_file "Kikimi/Info.plist"

# Start from a clean bundle so stale files from a previous build never ship.
rm -rf "$app_root"
mkdir -p "$app_dir/MacOS" "$app_dir/Resources"

cp .build/release/Kikimi "$app_dir/MacOS/Kikimi"
chmod +x "$app_dir/MacOS/Kikimi"

# Resource bundles
# ----------------
# `swift build` emits one `<Pkg>_<Target>.bundle` per dependency that declares resources
# (currently KeyboardShortcuts' localized strings). The accessor SwiftPM generates for them
# resolves exactly two paths:
#
#   1. Bundle.main.bundleURL / "<name>.bundle"   -> the .app *root*, for an app bundle
#   2. an absolute path into this checkout's .build directory, baked in at compile time
#
# and calls `fatalError` when neither exists. (2) is why a locally built .app works on this
# machine at all; on any other machine only (1) is left, so the bundle has to sit in the
# .app root — which `codesign` rejects ("unsealed contents present in the bundle root", the
# only entry it allows there is `Contents`).
#
# Hence the split: a release build puts the bundles where the accessor looks and ships
# unsigned (the same way Chirami ships), a local build keeps the signature that TCC needs
# and relies on path (2). Removing this divergence means patching the accessor away, i.e.
# depending on a fork of KeyboardShortcuts with the localization read from `Bundle.main`.
shopt -s nullglob
resource_bundles=(.build/release/*.bundle)
shopt -u nullglob

if [ "$release_build" = "1" ]; then
  bundle_dest="$app_root"
else
  bundle_dest="$app_dir/Resources"
fi

for bundle in "${resource_bundles[@]}"; do
  cp -R "$bundle" "$bundle_dest/"
  echo "Resources: $(basename "$bundle") copied to $bundle_dest/"
done

# The KeyboardShortcuts bundle is not optional: the 入力 settings tab instantiates
# `KeyboardShortcuts.Recorder`, whose init reads a localized string on the spot.
require_file "$bundle_dest/KeyboardShortcuts_KeyboardShortcuts.bundle/en.lproj/Localizable.strings" \
  "swift build did not emit the KeyboardShortcuts resource bundle"

# Menu bar icon
if [ -f "$menu_icon_src/MenuBarIcon.png" ]; then
  cp "$menu_icon_src/MenuBarIcon.png"    "$app_dir/Resources/MenuBarIcon.png"
  cp "$menu_icon_src/MenuBarIcon@2x.png" "$app_dir/Resources/MenuBarIcon@2x.png"
  echo "Icon: MenuBarIcon copied"
else
  echo "WARNING: $menu_icon_src/MenuBarIcon.png is absent — the menu bar item falls back"
  echo "         to its SF Symbol. Add the imageset to ship a custom icon."
fi

# アイコン (icns) 生成
if [ -f "$app_icon_src" ]; then
  iconset_parent="$(mktemp -d)"
  trap 'rm -rf "$iconset_parent"' EXIT
  iconset_dir="$iconset_parent/AppIcon.iconset"
  mkdir -p "$iconset_dir"
  sips -z 16   16   "$app_icon_src" --out "$iconset_dir/icon_16x16.png"      > /dev/null
  sips -z 32   32   "$app_icon_src" --out "$iconset_dir/icon_16x16@2x.png"   > /dev/null
  sips -z 32   32   "$app_icon_src" --out "$iconset_dir/icon_32x32.png"      > /dev/null
  sips -z 64   64   "$app_icon_src" --out "$iconset_dir/icon_32x32@2x.png"   > /dev/null
  sips -z 128  128  "$app_icon_src" --out "$iconset_dir/icon_128x128.png"    > /dev/null
  sips -z 256  256  "$app_icon_src" --out "$iconset_dir/icon_128x128@2x.png" > /dev/null
  sips -z 256  256  "$app_icon_src" --out "$iconset_dir/icon_256x256.png"    > /dev/null
  sips -z 512  512  "$app_icon_src" --out "$iconset_dir/icon_256x256@2x.png" > /dev/null
  sips -z 512  512  "$app_icon_src" --out "$iconset_dir/icon_512x512.png"    > /dev/null
  cp "$app_icon_src"                     "$iconset_dir/icon_512x512@2x.png"
  iconutil -c icns "$iconset_dir" -o "$app_dir/Resources/AppIcon.icns"
  echo "Icon: AppIcon.icns generated"
else
  echo "WARNING: $app_icon_src is absent — the .app ships with the generic macOS icon."
fi

# Info.plist の Xcode 変数を実値に置換
sed \
  -e 's/$(DEVELOPMENT_LANGUAGE)/en/' \
  -e "s/\$(EXECUTABLE_NAME)/Kikimi/" \
  -e "s/\$(PRODUCT_BUNDLE_IDENTIFIER)/$bundle_id/" \
  -e "s/\$(MARKETING_VERSION)/$version/" \
  -e "s/\$(CURRENT_PROJECT_VERSION)/$version/" \
  -e "s/\$(MACOSX_DEPLOYMENT_TARGET)/$deployment_target/" \
  Kikimi/Info.plist > "$app_dir/Info.plist"

# CFBundleIconFile is injected here rather than declared in Kikimi/Info.plist because the two
# build paths supply the icon differently: Xcode compiles Assets.xcassets and injects
# CFBundleIconName, while this SPM-based bundle ships a generated AppIcon.icns.
if [ -f "$app_dir/Resources/AppIcon.icns" ]; then
  /usr/bin/plutil -replace CFBundleIconFile -string "AppIcon" "$app_dir/Info.plist"
fi
/usr/bin/plutil -lint "$app_dir/Info.plist" > /dev/null

# sed silently no-ops on a pattern that does not match, which is how CFBundleShortVersionString
# stayed pinned at "1.0" through every build before the placeholders were introduced.
if grep -q '\$(' "$app_dir/Info.plist"; then
  fail "unsubstituted Xcode variable left in $app_dir/Info.plist"
fi
for key in CFBundleShortVersionString CFBundleVersion; do
  actual="$(/usr/bin/plutil -extract "$key" raw -o - "$app_dir/Info.plist")"
  [ "$actual" = "$version" ] || fail "Info.plist $key is '$actual', expected '$version'"
done

# Code signing
# ------------
# Without an explicit signature the bundle keeps the ad-hoc one that `swift build`
# applies at link time, whose designated requirement is `cdhash H"..."`. That hash
# changes on every build, so TCC silently revokes microphone / screen recording /
# accessibility each time — while still showing "allowed" in System Settings.
#
# Signing with a stable certificate makes the requirement reference the certificate
# instead of the hash, so permissions survive rebuilds. See `mise run signing-identity`.
#
# A release build skips this entirely: the certificate is local to this machine, so signing
# with it buys a downstream user nothing, and the resource-bundle layout a release needs
# (see above) is incompatible with a sealed bundle. Casks/kikimi.rb strips the quarantine
# attribute so macOS still opens the unsigned copy.
#
# `find-identity` is queried without -v on purpose: a self-signed certificate is never
# reported as "valid" (CSSMERR_TP_NOT_TRUSTED), yet codesign signs with it just fine.
identity="Kikimi Local Dev"
if [ "$release_build" = "1" ]; then
  echo "Release build: left unsigned (the Mach-O keeps swift build's ad-hoc signature)."
elif security find-identity -p codesigning 2>/dev/null | grep -qF "$identity"; then
  codesign --force --sign "$identity" \
    --identifier "$bundle_id" \
    --entitlements Kikimi/Kikimi.entitlements \
    "$app_root"
  echo "Signed with: $identity"
else
  codesign --force --sign - --identifier "$bundle_id" "$app_root"
  echo "WARNING: no '$identity' in the keychain — signed ad-hoc."
  echo "         macOS will revoke mic/screen/accessibility permissions on every build."
  echo "         Fix once with: mise run signing-identity"
fi

echo "Built $app_root (version: $version, bundle id: $bundle_id)"
