#!/usr/bin/env bash
#MISE description="Swift ビルド"
#MISE depends=["lint", "build:web"]
#MISE sources=["Kikimi/**/*.swift", "Package.swift"]
#MISE outputs=[".build/release/Kikimi"]
set -euo pipefail

# `lint` (read-only) instead of `lint-fix`: a build must never rewrite sources. `swiftlint --fix`
