#!/usr/bin/env bash
#MISE description="Swift ビルド (xcodebuild)"
#MISE depends=["lint", "build:web", "generate"]
#MISE sources=["Kikimi/**/*.swift", "Package.swift", "project.yml"]
#MISE outputs=[".build/release/Kikimi"]
set -euo pipefail

# `lint` (read-only) instead of `lint-fix`: a build must never rewrite sources. `swiftlint --fix`
# during the release build would silently mutate the checkout and hide violations that never get
# committed. Run `mise run lint-fix` explicitly when you want the autocorrections applied.

# Why xcodebuild and not `swift build`
# ------------------------------------
# SwiftPM on the command line does not compile Metal shaders. mlx-swift (pulled in for the
# Qwen3-ASR batch decoder) then ships without its `default.metallib`, and the failure is silent:
# the build succeeds, and the first MLX call traps at runtime with "Failed to load the default
# metallib". mlx-swift's README states it outright -- "the ultimate build has to be done via
# Xcode". So the real build path is xcodebuild against the project generated from `project.yml`,
# and that file is now load-bearing rather than a browsing aid.
#
# The products are copied back into `.build/release/` afterwards so `.mise/tasks/build/_default`
# -- which assembles, versions and signs the .app -- keeps working against the same paths it
# always has.

# shellcheck source=../_developer_dir.sh
source "$(dirname "${BASH_SOURCE[0]}")/../_developer_dir.sh"
resolve_developer_dir
echo "Using $DEVELOPER_DIR"

# The Metal toolchain is a separately downloaded component in Xcode 26. Without it the metallib
# is omitted exactly as it is under Command Line Tools, so fail loudly here rather than ship a
# binary that traps on first use.
if ! xcrun metal --version >/dev/null 2>&1; then
  echo "error: Metal toolchain missing. Run:" >&2
  echo "       xcodebuild -runFirstLaunch && xcodebuild -downloadComponent MetalToolchain" >&2
  exit 1
fi

derived="$PWD/.build/xcode"

# -skipPackagePluginValidation: mlx-swift ships a `CudaBuild` build-tool plugin, and Xcode asks
# for interactive trust the first time it sees one -- which a CLI build can never answer, so the
# build fails with "Validate plug-in ... in package mlx-swift". The plugin is inert on macOS
# (it only matters for Linux/CUDA builds).
xcodebuild \
  -scheme Kikimi \
  -destination 'platform=macOS' \
  -configuration Release \
  -derivedDataPath "$derived" \
  -skipPackagePluginValidation \
  -skipMacroValidation \
  build

products="$derived/Build/Products/Release"
app="$products/Kikimi.app"
[ -x "$app/Contents/MacOS/Kikimi" ] || {
  echo "error: xcodebuild produced no executable at $app/Contents/MacOS/Kikimi" >&2
  exit 1
}

mkdir -p .build/release
cp "$app/Contents/MacOS/Kikimi" .build/release/Kikimi

# SwiftPM resource bundles (KeyboardShortcuts' localized strings; later mlx-swift's
# default.metallib). Xcode places them inside the .app's Contents/Resources; copy them to the
# flat location the assembly task expects.
shopt -s nullglob
for bundle in "$app/Contents/Resources/"*.bundle; do
  rm -rf ".build/release/$(basename "$bundle")"
  cp -R "$bundle" .build/release/
done
shopt -u nullglob

echo "Built .build/release/Kikimi via xcodebuild"
