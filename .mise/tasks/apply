#!/usr/bin/env bash
#MISE description="~/Applications にインストール（録音中・ディクテーション中はスキップ）"
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_kikimi_control.sh
source "$script_dir/_kikimi_control.sh"

# Asked before the build, not after: a Release build is heavy enough to disturb the transcription
# running next to it, and there is no point producing a bundle that cannot be installed. Exit code
# 10 is the agreed "skipped, nothing is broken" signal (see CLAUDE.local.md 「デプロイ」).
busy_reason="$(kikimi_busy_reason)"
if [ -n "$busy_reason" ]; then
  echo "Skipped: $busy_reason."
  echo "Run 'mise run apply' again once Kikimi is idle, or set KIKIMI_APPLY_FORCE=1 to install"
  echo "anyway (this quits Kikimi mid-recording)."
  exit 10
fi

was_running=false
if pgrep -x Kikimi >/dev/null 2>&1; then
  was_running=true
fi
is_installed=false
if [ -d ~/Applications/Kikimi.app ]; then
  is_installed=true
fi

# Invoked here rather than via `#MISE depends` so it is guaranteed to run *after* the check above;
# mise may start dependencies concurrently with each other.
mise run build

app_path="build/Kikimi.app"
if [ ! -d "$app_path" ]; then
  echo "Error: $app_path not found"
  exit 1
fi

# Asked a second time, now that the build is done: a meeting may have started while it ran. The app
# decides and quits in one step (`docs/design/46-control-socket.md` §5), so nothing can slip in
# between. The build output stays on disk either way, which makes the retry after the meeting fast.
if ! quit_refusal="$(kikimi_stop_for_update)"; then
  echo "Built, but skipped the install: $quit_refusal."
  echo "Run 'mise run apply' again once Kikimi is idle (the build is already done)."
  exit 10
fi

mkdir -p ~/Applications
rm -rf ~/Applications/Kikimi.app
cp -R "$app_path" ~/Applications/Kikimi.app
echo "Installed to ~/Applications/Kikimi.app"

# 起動中だったら再起動、未インストールだったら新規起動
# `-g`: 前面化しない。Kikimi は LSUIElement（メニューバー常駐）なので前面に出す意味がなく、
# 出すと直前のアプリからフォーカスを奪う。業務用マシンで検証を回す前提の配慮
# （kikimi-verify SKILL.md 0 章）。
if [ "$was_running" = true ] || [ "$is_installed" = false ]; then
  # Retried: right after the old process dies and its bundle is replaced, LaunchServices can still
  # be holding the stale record and answers -600 (procNotFound). It catches up within a second.
  for attempt in 1 2 3; do
    open -g ~/Applications/Kikimi.app && break
    if [ "$attempt" = 3 ]; then
      echo "Error: could not launch ~/Applications/Kikimi.app" >&2
      exit 1
    fi
    sleep 1
  done
  if [ "$was_running" = true ]; then
    echo "Restarted Kikimi"
  else
    echo "Started Kikimi"
  fi
fi
