#!/usr/bin/env bash
#MISE description="作業用 worktree を .claude/worktrees/<branch> に作る"
set -euo pipefail

# One worktree per PR (docs/development-process.md 2.11). `.claude/worktrees/` is where Claude
# Code's own EnterWorktree puts them, and switching a session between worktrees mid-session only
# works for paths under that directory -- so this task uses the same place rather than a sibling
# directory outside the repo.

branch=""
move=false
for arg in "$@"; do
  case "$arg" in
    --move) move=true ;;
    -*) echo "unknown option: $arg" >&2; exit 2 ;;
    *) [ -z "$branch" ] && branch="$arg" ;;
  esac
done

if [ -z "$branch" ]; then
  echo "usage: mise run wt <branch-name> [--move]" >&2
  echo "   e.g. mise run wt fix/summary-pane-blank" >&2
  echo "        mise run wt fix/summary-pane-blank --move   # 未コミットの作業も一緒に運ぶ" >&2
  exit 2
fi

# Always operate on the main checkout, even when invoked from inside another worktree: the first
# entry of `git worktree list` is the main one.
main_worktree="$(git worktree list --porcelain | awk 'NR == 1 && $1 == "worktree" { print $2 }')"
if [ -z "$main_worktree" ]; then
  echo "error: not inside a git repository" >&2
  exit 1
fi

path="$main_worktree/.claude/worktrees/$branch"

already_existed=false
if [ -d "$path" ]; then
  echo "already exists: $path"
  if ! $move; then
    exit 0
  fi
  already_existed=true
fi

if ! $already_existed; then

git -C "$main_worktree" fetch --quiet origin main

# Branch off origin/main, not the local one: the local main may be behind, and a PR built on a
# stale base is the one thing the required status checks cannot catch (the ruleset's
# strict_required_status_checks_policy is off).
if git -C "$main_worktree" show-ref --verify --quiet "refs/heads/$branch"; then
  echo "branch $branch already exists; checking it out into the new worktree"
  git -C "$main_worktree" worktree add "$path" "$branch"
else
  git -C "$main_worktree" worktree add -b "$branch" "$path" origin/main
fi

# mise refuses to parse a config it has not been told to trust, and trust is keyed by absolute
# path -- so every fresh worktree starts untrusted and *every* `mise run` in it fails with
# "Config files ... are not trusted" until this runs.
mise trust "$path/mise.toml" >/dev/null

# Gitignored but load-bearing: without these the agents in the new worktree lose the reference
# rules (CLAUDE.local.md) and the map of the sibling Chirami checkout.
for file in CLAUDE.local.md docs/references/chirami-map.md; do
  if [ -f "$main_worktree/$file" ]; then
    mkdir -p "$path/$(dirname "$file")"
    cp "$main_worktree/$file" "$path/$file"
  fi
done

# `cp -c` is an APFS clone: it takes seconds for the ~10GB `.build` tree and shares every block
# until something writes to it. Without it each worktree pays a from-scratch build of all the
# dependencies (MLX, FluidAudio, sherpa-onnx) before its first commit can pass the
# build-before-commit hook.
for dir in .build web/node_modules Kikimi/Resources/editor; do
  [ -e "$main_worktree/$dir" ] || continue
  mkdir -p "$(dirname "$path/$dir")"
  cp -c -R "$main_worktree/$dir" "$path/$dir"
done

# Clang bakes the absolute module-cache path into every .pcm and refuses to load one from
# anywhere else ("was compiled with module cache path ..."), which fails the build outright. It is
# a pure cache, so dropping the copies costs nothing and is what makes the clone above usable.
if [ -d "$path/.build" ]; then
  find "$path/.build" -type d -name ModuleCache -prune -exec rm -rf {} +
fi

fi # ! already_existed

# `--move`: carry the main checkout's uncommitted work into the new worktree and leave `main`
# clean. The recovery path when an edit landed on `main` by mistake -- which the
# `no-edit-on-main.sh` PreToolUse hook now prevents at the source, but which still needs a
# one-command fix for work that predates it (or that arrived via `KIKIMI_ALLOW_MAIN_EDIT=1`).
#
# Deliberately not `git stash`: the stash stack is shared by the main checkout and every worktree,
# and concurrent agent sessions pop each other's entries. A patch plus an explicit copy of the
# untracked files touches nothing anyone else can see.
if $move; then
  tracked_patch="$(mktemp -t kikimi-wt-move)"
  git -C "$main_worktree" diff HEAD --binary > "$tracked_patch"
  # `--others --exclude-standard` = new files the user wrote, minus everything gitignored (.build,
  # CLAUDE.local.md, ...), which the clone above already handled.
  untracked="$(git -C "$main_worktree" ls-files --others --exclude-standard)"

  if [ ! -s "$tracked_patch" ] && [ -z "$untracked" ]; then
    echo "--move: nothing to move ($main_worktree is clean)"
    rm -f "$tracked_patch"
  else
    if [ -s "$tracked_patch" ]; then
      # Refuse rather than half-apply: a patch that does not fit means the worktree is not the
      # pristine origin/main the caller assumed, and silently mangling the only copy of the work
      # would be unrecoverable.
      if ! git -C "$path" apply --check "$tracked_patch" 2>/dev/null; then
        echo "error: the uncommitted changes do not apply cleanly onto $branch." >&2
        echo "       Nothing was moved; $main_worktree is untouched. Patch kept at $tracked_patch" >&2
        exit 1
      fi
      git -C "$path" apply "$tracked_patch"
    fi

    if [ -n "$untracked" ]; then
      printf '%s\n' "$untracked" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        mkdir -p "$path/$(dirname "$file")"
        cp "$main_worktree/$file" "$path/$file"
      done
    fi

    # Only now that everything is safely in the new worktree, restore the main checkout.
    if [ -s "$tracked_patch" ]; then
      git -C "$main_worktree" checkout -- .
    fi
    if [ -n "$untracked" ]; then
      printf '%s\n' "$untracked" | while IFS= read -r file; do
        [ -n "$file" ] || continue
        rm -f "$main_worktree/$file"
      done
    fi
    rm -f "$tracked_patch"

    echo
    echo "--move: carried over and restored $main_worktree"
    git -C "$path" status --short
  fi
fi

echo
echo "worktree: $path"
echo "branch:   $branch (based on origin/main)"
echo
echo "next: cd \"$path\" && … && mise run pr:wait"
